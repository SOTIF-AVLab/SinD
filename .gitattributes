# Public sample trajectory CSVs include one file larger than GitHub's normal
# 100 MiB file limit, so keep sample data in Git LFS.
Data/**/*.csv filter=lfs diff=lfs merge=lfs -text

# Keep accidental large binary artifacts out of normal git history if they are
# intentionally added later.
*.pkl filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pth.tar filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
